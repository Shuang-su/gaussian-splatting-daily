{
  "name": "gaussian-splatting-daily-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "content": "node --import tsx scripts/build-content.ts",
    "media": "node --import tsx scripts/prepare-media.ts",
    "share": "node --import tsx scripts/build-share.ts",
    "build": "npm run content && next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}

{
  "name": "gaussian-daily-reference-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:sspai": "vite --mode sspai --host 127.0.0.1 --port 4340 --strictPort",
    "dev:radiance": "vite --mode radiance --host 127.0.0.1 --port 4341 --strictPort",
    "build": "npm run typecheck && vite build --mode sspai && vite build --mode radiance && node scripts/export-routes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare:sources": "node scripts/prepare-sources.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fancyapps/ui": "6.1.15",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "sharp": "0.35.5",
    "tsx": "4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
